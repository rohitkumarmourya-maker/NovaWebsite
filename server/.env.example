# Copy to server/.env for local Node hosting; set these in Vercel for deployment.
NODE_ENV=production
PORT=8787
TRUST_PROXY=1
SERVE_STATIC=false
STATIC_DIR=dist
SITE_URL=https://nova-final-nine.vercel.app
# Only for a frontend on a different origin. Comma-separated exact origins.
ALLOWED_ORIGINS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=codekraft.hub@gmail.com
# Required: Google app password for the account above. Spaces are removed.
SMTP_PASS=
# Alternative if SMTP_PASS is empty:
GMAIL_APP_PASSWORD=
# MAIL_FROM cannot override the required codekraft.hub@gmail.com sender.
MAIL_TO=novaventures.nvit@gmail.com
# Optional routing overrides; blank means MAIL_TO, then NOVA_RECIPIENT_EMAIL.
CAREERS_TO=
CONTACT_TO=
NOVA_RECIPIENT_EMAIL=
# Optional confirmation to applicants, awaited before the function ends.
SEND_ACKNOWLEDGEMENT=false
# Only permitted when NODE_ENV is not production and VERCEL is not set.
MAIL_DRY_RUN=false
