# ---------------------------------------------------------------------------
# Nova Ventures form API — configuration
# Copy this file to  server/.env  and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=8787

# Set to 1 (or the number of proxy hops) when running behind Nginx, Render, Railway,
# Cloudflare, etc. so rate limiting sees the real visitor IP.
TRUST_PROXY=1

# Serve the built website (dist/) from this same process. Simplest single-server deployment.
SERVE_STATIC=true
STATIC_DIR=dist

# Only needed when the website is hosted on a different domain than this API
# (e.g. site on Netlify, API on Render). Comma-separated, no trailing slashes.
ALLOWED_ORIGINS=

# Public site URL (used in e-mail footers)
SITE_URL=https://www.novaventures.example

# ---------------------------------------------------------------------------
# Mail delivery via Gmail SMTP
#   1. Sign in to novaventures.nvit@gmail.com
#   2. Google Account → Security → turn on 2-Step Verification
#   3. Google Account → Security → App passwords → create one named "Website forms"
#   4. Paste the 16-character password below (spaces are ignored)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=novaventures.nvit@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where applications and enquiries are delivered. Multiple addresses: a@x.com, b@y.com
MAIL_TO=novaventures.nvit@gmail.com
MAIL_FROM="Nova Ventures Website" <novaventures.nvit@gmail.com>

# Send the candidate an automatic confirmation e-mail with their reference number
SEND_ACKNOWLEDGEMENT=true

# Local testing without SMTP: write e-mails to server/outbox/ instead of sending them
MAIL_DRY_RUN=false

# ---------------------------------------------------------------------------
# Anti-abuse
# ---------------------------------------------------------------------------
# Submissions faster than this many seconds after the form loaded are treated as bots
MIN_FORM_SECONDS=4
# Optional: Cloudflare Turnstile secret key (leave empty to disable)
TURNSTILE_SECRET=
