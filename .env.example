# Front-end build variables (read at build time by vite.config.ts / site.config.mjs).
# Copy to `.env` and adjust. Never put secrets in this file — it is bundled into the browser build.

# Public URL of the website (no trailing slash). Used for canonical links, sitemap, Open Graph.
VITE_SITE_URL=https://www.novaventures.example

# Origin of the form API when it is hosted separately (leave empty when the API is served
# from the same domain, e.g. Express serving dist/ or a reverse proxy mapping /api).
VITE_API_BASE=
